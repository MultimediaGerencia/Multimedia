# ACTIC: cuenta para transferencias y responsable que da el acceso al Moodle
IBAN_ACTIC=ES57 0049 4365 5928 1004 1744
RESPONSABLE_ACTIC=

# Teams: dirección del flujo de Workflows del canal del equipo
TEAMS_WEBHOOK_URL=

# Servidor
PUERTO=3000
# DIR_DATOS=/var/lib/agente-whatsapp
URL_PRIVACIDAD=https://www.multimediatarragona.com/politica-de-privadesa/
